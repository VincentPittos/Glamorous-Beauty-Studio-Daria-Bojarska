# ---------------------------------------------------------------------------
# Rezerwacje w GoHighLevel
# ---------------------------------------------------------------------------
#
# Kalendarz uslug GHL osadzamy jako widzet. Skopiuj adres z panelu GHL:
# Calendars -> wybrany kalendarz -> Share -> Embed. Interesuje nas sam adres
# z atrybutu src, czyli cos w rodzaju:
#   https://api.leadconnectorhq.com/widget/booking/XXXXXXXXXXXX
# albo, przy menu uslug:
#   https://api.leadconnectorhq.com/widget/service-menu/XXXXXXXXXXXX
#
# DOPOKI TA ZMIENNA JEST PUSTA, dziala wbudowany kalendarz podgladowy.
# Terminy sa w nim przykladowe i jest o tym napisane nad kalendarzem.
NEXT_PUBLIC_GHL_KALENDARZ_URL=

# Formularz pytan. Adres webhooka z GHL (Automations -> Workflows -> trigger
# Inbound Webhook). Bez tego formularz nadal dziala, ale zgloszenie laduje
# tylko w logach serwera.
GHL_WEBHOOK_URL=

# Rezerwacja z kalendarza podgladowego. Zaklada wizyte NIEPOTWIERDZONA.
# Gdy zmienna jest pusta, trasa uzywa GHL_WEBHOOK_URL.
GHL_WEBHOOK_REZERWACJA_URL=

# Potwierdzenie wizyty po wplacie zadatku. Wola go WYLACZNIE webhook
# platnosci, po sprawdzeniu podpisu. Workflow po drugiej stronie ma
# przestawic status wizyty na potwierdzona, dodac tag zadatek-oplacony
# i wyslac SMS oraz e-mail z potwierdzeniem.
GHL_WEBHOOK_POTWIERDZENIE_URL=

# ---------------------------------------------------------------------------
# Zadatek 50 zl
# ---------------------------------------------------------------------------
#
# Link platnosci z GHL Payments albo Stripe Checkout. Kwote ustaw PO STRONIE
# OPERATORA, nigdy w adresie, bo adres da sie podmienic w przegladarce.
# Dla polskich klientek wlacz BLIK i Przelewy24, nie samo karty.
NEXT_PUBLIC_LINK_PLATNOSCI_ZADATEK=

# Sekret, ktorym operator platnosci podpisuje webhooki. Trasa
# /api/platnosc/webhook liczy z niego HMAC SHA-256 z surowego ciala zadania
# i bez zgodnego podpisu odrzuca zgloszenie.
#
# BEZ TEJ ZMIENNEJ TRASA JEST ZAMKNIETA i odpowiada bledem 503. Tak ma byc:
# lepiej, zeby platnosci nie potwierdzaly sie wcale, niz zeby potwierdzal je
# ktokolwiek, kto zna adres.
WEBHOOK_PLATNOSCI_SEKRET=

# ---------------------------------------------------------------------------
# Adres produkcyjny
# ---------------------------------------------------------------------------
#
# Uzywany w sitemap, robots, danych strukturalnych i Open Graph.
NEXT_PUBLIC_ADRES_STRONY=https://glamorousbeautystudio.pl
